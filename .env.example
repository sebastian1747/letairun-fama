# Composio (X access via Kolibri)
COMPOSIO_API_KEY=
# The ca_… id of the connected FAMA X account (Composio → Connected Accounts)
COMPOSIO_CONNECTED_ACCOUNT_ID=
# Only used when COMPOSIO_CONNECTED_ACCOUNT_ID is empty
COMPOSIO_ENTITY_ID=default

# letairun.com FAMA API
FAMA_SITE_URL=https://www.letairun.com
FAMA_API_KEY=

# Session defaults
FAMA_MODEL=opus
# FAMA_DRY_RUN=1
